# SECRET_KEY=replace-with-a-long-random-value
# DATABASE_URL=sqlite:///astrahaven.db
# FLASK_DEBUG=0



SECRET_KEY=change-this-in-production
DATABASE_URL=sqlite:///astrahaven.db

FLASK_ENV=development
FLASK_DEBUG=1

SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax

RATELIMIT_DEFAULT=100 per min

For PostgreSQL:
DATABASE_URL=postgresql+psycopg://AstraHaven:AstraHaven_password@localhost:5432/AstraHaven